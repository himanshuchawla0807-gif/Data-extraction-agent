APP_NAME=Data Extraction Agent Open
APP_ENV=development
HOST=0.0.0.0
PORT=8101
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173

DATA_EXTRACTION_PROVIDER=mock
DATA_EXTRACTION_MODEL=mock-extractor

OPENAI_API_KEY=
