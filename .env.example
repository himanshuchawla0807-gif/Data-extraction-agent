APP_NAME=Data Extraction Agent Open
APP_ENV=development
HOST=0.0.0.0
PORT=8101
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$
FRONTEND_URL=http://localhost:5173

DATA_EXTRACTION_PROVIDER=opencode
DATA_EXTRACTION_MODEL=opencode
OPENCODE_API_PROVIDER=anthropic
OPENCODE_MODEL=
OPENCODE_COMMAND=opencode
OPENCODE_TIMEOUT_SECONDS=300
OPENCODE_BROWSER_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
LOCAL_EMBEDDING_DIR=~/.users/embeddings/data-extraction-agent-open
MAX_DOCUMENT_CHARS=120000
MAX_UPLOAD_MB=50
SESSION_STORE=./storage/sessions.json
