{
  "name": "data-extraction-agent-open",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python cli.py",
    "dev:backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8101 --reload",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "test": "python -m pytest tests",
    "install:frontend": "npm --prefix frontend install",
    "install:python": "python -m pip install -r requirements.txt"
  }
}
