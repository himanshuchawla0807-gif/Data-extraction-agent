{
  "name": "data-extraction-agent-open",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first OpenCode-backed data extraction agent for document-to-table workflows.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "oriplex-data": "./cli.py",
    "oriplex-gateway": "./cli.py"
  },
  "scripts": {
    "dev": "node scripts/oriplex-gateway.mjs gateway",
    "gateway": "node scripts/oriplex-gateway.mjs gateway",
    "gateway:start": "node scripts/oriplex-gateway.mjs start",
    "gateway:setup": "node scripts/oriplex-gateway.mjs setup",
    "gateway:doctor": "node scripts/oriplex-gateway.mjs doctor",
    "models": "node scripts/oriplex-gateway.mjs models",
    "dev:backend": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8101 --reload",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173",
    "test": "python -m pytest tests",
    "install:frontend": "npm --prefix frontend ci",
    "install:python": "python -m pip install --require-hashes -r requirements.lock"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.19.0"
}
